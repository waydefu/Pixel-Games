{
  "name": "pixel-games",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Saint Aldric Harbour: single-file offline procedural medieval coast",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run check:mainline && npm run check:governance",
    "assets": "npm run check:artifact",
    "test": "node --test tests/harbour/*.test.js tests/governance.test.mjs",
    "typecheck": "node scripts/check-mainline.mjs",
    "build": "vite build && node scripts/inline-mainline.mjs",
    "check:build": "npm run check:artifact",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "validate": "npm run check:mainline && npm run test && npm run build && npm run check:artifact",
    "graphics:matrix": "node -e \"throw new Error('Legacy graphics matrix is not a Saint Aldric acceptance gate. Use test:e2e and issue #120.')\"",
    "visual:audit": "npm run test:e2e",
    "check:governance": "node --test tests/governance.test.mjs",
    "perf:run": "node -e \"throw new Error('Legacy HD-2D performance harness cannot measure Saint Aldric. Follow docs/QUALITY-GATES.md.')\"",
    "perf:compare": "node scripts/performance/compare.mjs",
    "legacy:build": "vite build",
    "legacy:validate": "npm run check && npm run assets && npm test && npm run typecheck && npm run build && npm run check:build",
    "legacy:test": "node --test",
    "legacy:typecheck": "tsc --noEmit",
    "legacy:test:e2e": "playwright test",
    "legacy:check:governance": "node scripts/check-governance.mjs",
    "legacy:perf:run": "npm run build && node scripts/performance/run.mjs",
    "legacy:graphics:matrix": "node scripts/graphics-matrix.mjs",
    "test:unit": "npm run test",
    "check:mainline": "node scripts/check-mainline.mjs",
    "check:artifact": "node scripts/check-mainline.mjs --artifact",
    "check:repo": "npm run check:mainline",
    "check:assets": "npm run check:artifact",
    "check:generated": "npm run check:mainline",
    "check:budgets": "npm run check:artifact"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
